<shape image="dataprocess_icon" name="shape6" shapetype="dataprocess" userlabel="Unwrap ST Multipart" x="240.0" y="48.0">
  <configuration>
<dataprocess>
  <step index="1" key="1" name="Custom Scripting" processtype="12">
    <dataprocessscript language="groovy2" useCache="true">
      <script>import java.util.Properties
import java.io.InputStream
import com.boomi.execution.ExecutionUtil

/* ST Generic-HTTP(S) PUT sends the file as multipart/form-data. Extract the part's filename
   and emit the original bytes; non-multipart bodies pass through unchanged. Binary-safe. */
String queryName = ExecutionUtil.getDynamicProcessProperty("query_filename") ?: ""
for (int i = 0; i &lt; dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i)
    Properties props = dataContext.getProperties(i)
    byte[] raw = is.bytes
    String s = new String(raw, "ISO-8859-1")   /* one char per byte, so offsets are byte offsets */
    String name = queryName
    String mode = "raw"
    InputStream out = new ByteArrayInputStream(raw)
    String nl = s.indexOf("\r\n") &gt;= 0 ? "\r\n" : "\n"
    int eol = s.indexOf(nl)
    if (s.startsWith("--") &amp;&amp; eol &gt; 2) {
        String boundary = s.substring(0, eol)
        int hdrEnd = s.indexOf(nl + nl, eol)
        int end = hdrEnd &gt; 0 ? s.indexOf(nl + boundary, hdrEnd + 2 * nl.length()) : -1
        if (end &gt; hdrEnd) {
            def m = (s.substring(eol, hdrEnd) =~ /filename="([^"]*)"/)
            if (m.find() &amp;&amp; m.group(1)) name = m.group(1)
            int start = hdrEnd + 2 * nl.length()
            out = new ByteArrayInputStream(raw, start, end - start)
            mode = "multipart"
        }
    }
    props.setProperty("document.dynamic.userdefined.DDP_ST_FILENAME", name ?: "unknown")
    props.setProperty("document.dynamic.userdefined.DDP_ST_PAYLOAD_MODE", mode)
    dataContext.storeStream(out, props)
}</script>
    </dataprocessscript>
  </step>
</dataprocess>
